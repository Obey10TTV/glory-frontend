# Glory uses the deployed Railway API by default when this is omitted.
VITE_API_URL=https://glory-store-production.up.railway.app/api

# Public Google OAuth web client ID. Use the same client ID as GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=

# Optional local backend override for development.
# VITE_USE_LOCAL_API=true
